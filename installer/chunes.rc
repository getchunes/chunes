// Windows resources linked into Chunes.exe by build.rs.
//
// build.rs writes chunes_version.h into OUT_DIR, which is on the include
// path, with the Cargo.toml package version and the absolute paths of the
// icon and manifest.
// The generated header holds absolute paths, which may not be ASCII.
#pragma code_page(65001)
#include "chunes_version.h"

// The tray loads its icon by resource ID 1, so this ordinal must not change.
1 ICON CHUNES_ICON_FILE

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1) of type RT_MANIFEST (24).
1 24 CHUNES_MANIFEST_FILE

1 VERSIONINFO
FILEVERSION CHUNES_VERSION_BINARY
PRODUCTVERSION CHUNES_VERSION_BINARY
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Chunes"
            VALUE "FileDescription", "Chunes Discord music presence"
            VALUE "FileVersion", CHUNES_VERSION_STRING
            VALUE "InternalName", "Chunes"
            VALUE "LegalCopyright", "Copyright 2026 Chunes contributors"
            VALUE "OriginalFilename", "Chunes.exe"
            VALUE "ProductName", "Chunes"
            VALUE "ProductVersion", CHUNES_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
